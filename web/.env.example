# Public site origin (used for canonical URLs, OG tags, sitemap, JSON-LD @id)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi REST API base used for server-to-server data fetching. In production
# this can (and should) be an internal address (e.g. http://127.0.0.1:1337)
# to skip an extra public network hop.
STRAPI_URL=http://localhost:1337

# Publicly reachable Strapi origin used to build image/media URLs that end
# up in the HTML sent to browsers. Must be a real, internet-reachable
# hostname — NEVER 127.0.0.1/localhost in production, or every visitor's
# browser will try to load images from their own machine. Defaults to
# STRAPI_URL when unset, which is only correct when STRAPI_URL is itself
# already public (e.g. local dev).
NEXT_PUBLIC_STRAPI_MEDIA_URL=http://localhost:1337

# Read-only API token from Strapi (Settings -> API Tokens). Optional while the
# Public role can read Post/Author/Category/Tag. NEVER prefix with NEXT_PUBLIC_.
STRAPI_API_TOKEN=

# Shared secrets for the Strapi -> Next webhooks
STRAPI_WEBHOOK_SECRET=
STRAPI_PREVIEW_SECRET=

# Resend API key (resend.com) used by /api/contact to deliver enquiries by
# email. Without this, submissions are only logged server-side and no one
# receives them.
RESEND_API_KEY=

# Mailbox that receives contact-form enquiries. Defaults to SITE.email.
CONTACT_TO_EMAIL=info@tasamaconsultancy.com

# Verified sender identity in your Resend account. Defaults to Resend's
# shared onboarding@resend.dev sender, which only works for testing.
CONTACT_FROM_EMAIL=
