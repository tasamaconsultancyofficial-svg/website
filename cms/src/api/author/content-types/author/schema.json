{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Post author - feeds the Person node in Article JSON-LD (E-E-A-T / GEO)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "jobTitle": {
      "type": "string"
    },
    "bio": {
      "type": "text",
      "maxLength": 600
    },
    "credentials": {
      "type": "text",
      "maxLength": 400
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "email": {
      "type": "email",
      "private": true
    },
    "linkedinURL": {
      "type": "string"
    },
    "twitterURL": {
      "type": "string"
    },
    "websiteURL": {
      "type": "string"
    },
    "knowsAbout": {
      "type": "json"
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "author"
    }
  }
}
