{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "A blog article for Tasama Insights"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "coverImageAlt": {
      "type": "string",
      "required": true
    },
    "tldr": {
      "type": "text",
      "maxLength": 600
    },
    "keyPoints": {
      "type": "component",
      "repeatable": true,
      "component": "content.key-point"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "content.faq-item"
    },
    "sources": {
      "type": "component",
      "repeatable": true,
      "component": "content.source"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "posts"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "posts"
    },
    "readingTimeMinutes": {
      "type": "integer",
      "min": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "datePublishedOverride": {
      "type": "datetime"
    },
    "dateReviewed": {
      "type": "date"
    }
  }
}
