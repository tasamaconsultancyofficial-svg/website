# ---- Server ----
HOST=0.0.0.0
PORT=1337
# Public URL Strapi builds absolute media/admin links from.
# Production: https://cms.tasamaconsultancy.com
PUBLIC_URL=http://localhost:1337
# Set true when running behind a TLS-terminating proxy / load balancer.
IS_PROXIED=false

# ---- Secrets (generate fresh per environment) ----
# node -e "console.log(Array.from({length:4},()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# ---- Database ----
# Local dev: sqlite. Production: switch to postgres.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/strapi
# DATABASE_SSL=true

# ---- CORS ----
# Extra browser origins allowed to call the API, comma-separated.
# The base allowlist (insights + apex + localhost) is always included.
CORS_ORIGINS=

# ---- Webhook back to Next.js (optional; configured in Strapi admin UI) ----
# Used only as reference; the secret is set on the webhook in Settings -> Webhooks.
WEBHOOKS_POPULATE_RELATIONS=true
